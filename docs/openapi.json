    "/api/v1/links/{code}/stats": {
      "get": {
        "tags": [
          "links"
        ],
        "summary": "Stats",
        "description": "Click analytics: totals, unique visitors, time series, referrers, browsers, OS, devices, countries.\nRecent clicks may lag by up to ~1s (asynchronous recording).",
        "operationId": "stats_api_v1_links__code__stats_get",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Code"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Range start (default: 7 days, or 24h for hourly, before `to`)",
              "title": "From"
            },
            "description": "Range start (default: 7 days, or 24h for hourly, before `to`)"
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Range end (default: now)",
              "title": "To"
            },
            "description": "Range end (default: now)"
          },
          {
            "name": "granularity",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "hour",
                "day"
              ],
              "type": "string",
              "default": "day",
              "title": "Granularity"
            }
          },
          {
            "name": "top",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "description": "Max rows per breakdown",
              "default": 10,
              "title": "Top"
            },
            "description": "Max rows per breakdown"
          },
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "API key issued via POST /api/v1/keys",
              "title": "X-Api-Key"
            },
            "description": "API key issued via POST /api/v1/keys"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatsOut"
                }
              }
            }
          },
          "401": {
            "description": "Missing/invalid API key"
          },
          "404": {
            "description": "Link not found"
          },
          "429": {
            "description": "Rate limit exceeded (see Retry-After)"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },

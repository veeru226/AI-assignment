        ],
        "summary": "Delete Link",
        "description": "Soft-delete: the code stops redirecting (410) and click history is retained.",
        "operationId": "delete_link_api_v1_links__code__delete",
        "parameters": [
          {
            "name": "code",
            "in": "path",

  "components": {
    "schemas": {
      "ApiKeyCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ],
        "title": "ApiKeyCreate"
      },
      "ApiKeyCreated": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "prefix": {
            "type": "string",
            "title": "Prefix"
          },
          "api_key": {
            "type": "string",
            "title": "Api Key",
            "description": "Shown once; only a hash is stored"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "prefix",
          "api_key"
        ],
        "title": "ApiKeyCreated"
      },
      "BulkCreateRequest": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/CreateLinkRequest"
            },
            "type": "array",
            "minItems": 1,
            "title": "Items"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items"
        ],
        "title": "BulkCreateRequest"
      },
      "BulkCreateResponse": {
        "properties": {
          "results": {
            "items": {
              "$ref": "#/components/schemas/BulkItemResult"
            },
            "type": "array",
            "title": "Results"
          },
          "created": {
            "type": "integer",
            "title": "Created"
          },
          "existing": {
            "type": "integer",
            "title": "Existing"
          },
          "failed": {
            "type": "integer",
            "title": "Failed"
          }
        },
        "type": "object",
        "required": [
          "results",
          "created",
          "existing",
          "failed"
        ],
        "title": "BulkCreateResponse"
      },
      "BulkItemResult": {
        "properties": {
          "index": {
            "type": "integer",
            "title": "Index"
          },
          "status": {
            "type": "string",
            "enum": [
              "created",
              "existing",
              "error"
            ],
            "title": "Status"
          },
          "link": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LinkOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorBody"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "index",
          "status"
        ],
        "title": "BulkItemResult"
      },
      "CountItem": {
        "properties": {
          "value": {
            "type": "string",
            "title": "Value"
          },
          "clicks": {
            "type": "integer",
            "title": "Clicks"
          }
        },
        "type": "object",
        "required": [
          "value",
          "clicks"
        ],
        "title": "CountItem"
      },
      "CreateLinkRequest": {
        "properties": {
          "url": {
            "type": "string",
            "title": "Url",
            "description": "Destination http(s) URL",
            "examples": [
              "https://example.com/some/long/path?x=1"
            ]
          },
          "custom_alias": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Custom Alias",
            "description": "Optional vanity code, 3-32 chars [A-Za-z0-9_-]"
          },
          "ttl_seconds": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Ttl Seconds",
            "description": "Expire this many seconds from now"
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At",
            "description": "Absolute expiry (timezone required)"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "url"
        ],
        "title": "CreateLinkRequest"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LinkList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/LinkOut"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "title": "LinkList"
      },
      "LinkOut": {
        "properties": {
          "short_code": {
            "type": "string",
            "title": "Short Code"
          },
          "short_url": {
            "type": "string",
            "title": "Short Url"
          },
          "long_url": {
            "type": "string",
            "title": "Long Url"
          },
          "is_custom": {
            "type": "boolean",
            "title": "Is Custom"
          },
          "is_active": {
            "type": "boolean",
            "title": "Is Active"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "expired",
              "disabled"
            ],
            "title": "Status"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"

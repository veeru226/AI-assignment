# All settings are environment variables (or this file copied to .env).
ENV=development
DATABASE_URL=sqlite:///./urlshortener.db
# For PostgreSQL (also: pip install "psycopg[binary]"):
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/shortener
BASE_URL=http://localhost:8000

# REQUIRED when ENV=production: long random value (e.g. python -c "import secrets;print(secrets.token_urlsafe(48))").
# Changing it later changes every generated short code.
SECRET_KEY=change-me
# Enables POST /api/v1/keys. Leave empty to disable and use `python -m app.manage create-key`.
ADMIN_API_KEY=

RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=30
CACHE_MAX_ENTRIES=50000
CACHE_TTL_SECONDS=300
# Only behind a proxy you control (trusts X-Forwarded-For and CF-IPCountry):
TRUST_PROXY_HEADERS=false
# Optional MaxMind GeoLite2-Country.mmdb for country analytics:
GEOIP_DB_PATH=
